VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# RevenueCat Web Billing public API key (sandbox key for local/preview; see app.revenuecat.com)
VITE_RC_WEB_API_KEY=

# Meta Pixel ID (Events Manager > Data Sources > this pixel > Settings). Unset until Luke
# creates the pixel; index.html / scripts/prerender.js no-op fbq entirely when this is blank.
VITE_META_PIXEL_ID=

# Google Ads conversion ID for the gtag.js loader, e.g. "AW-XXXXXXXXXX" (Google Ads >
# Tools > Conversions). Unset until Luke creates the conversion action; index.html /
# scripts/prerender.js no-op gtag entirely when this is blank.
VITE_GOOGLE_ADS_ID=
